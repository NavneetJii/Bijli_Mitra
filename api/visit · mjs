// Records one visit together with the visitor's APPROXIMATE area.
// Vercel adds geo headers to every request; we read them here, pass only
// country / state / city to the database, and never store the IP address.
export default async function handler(req, res) {
  res.setHeader("Cache-Control", "no-store");
  if (req.method !== "POST") return res.status(405).json({ ok: false });

  const url = process.env.VITE_SUPABASE_URL || process.env.SUPABASE_URL;
  const key = process.env.VITE_SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY;
  if (!url || !key) return res.status(500).json({ ok: false });

  let body = req.body;
  if (typeof body === "string") { try { body = JSON.parse(body); } catch { body = {}; } }
  const visitorId = body && typeof body.visitorId === "string" ? body.visitorId : "";
  if (visitorId.length < 8 || visitorId.length > 100) return res.status(400).json({ ok: false });

  const dec = (v) => { try { return decodeURIComponent(String(v || "")); } catch { return String(v || ""); } };
  const h = req.headers;
  const country = dec(h["x-vercel-ip-country"]);
  const region = dec(h["x-vercel-ip-country-region"]);
  const city = dec(h["x-vercel-ip-city"]);

  try {
    const r = await fetch(`${url}/rest/v1/rpc/record_site_visit`, {
      method: "POST",
      headers: { "Content-Type": "application/json", apikey: key, Authorization: `Bearer ${key}` },
      body: JSON.stringify({
        p_visitor_id: visitorId,
        p_user_agent: String(body.userAgent || h["user-agent"] || "").slice(0, 300),
        p_country: country || null,
        p_region: region || null,
        p_city: city || null
      })
    });
    return res.status(r.ok ? 200 : 502).json({ ok: r.ok });
  } catch {
    return res.status(502).json({ ok: false });
  }
}
